<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Termius Dark) -->
    <style name="Theme.LeuwiPanjang" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        
        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        
        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Status & Nav Bar -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Terminal Fullscreen Theme -->
    <style name="Theme.LeuwiPanjang.Terminal" parent="Theme.LeuwiPanjang">
        <item name="android:windowBackground">@color/terminal_bg</item>
        <item name="android:statusBarColor">@color/terminal_bg</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
    </style>

    <!-- Custom Card Style -->
    <style name="Widget.LeuwiPanjang.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/stroke_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Accessory Key Button -->
    <style name="Widget.LeuwiPanjang.KeyButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/terminal_key_btn_bg</item>
        <item name="android:textColor">@color/terminal_key_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">38dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
